@model BabyToddlerEssentials.ViewModels.OrderDetailsVM
@using BabyToddlerEssentials.Models.Enums

@{
    ViewData["Title"] = $"Order #{Model.Order.Id}";
    ViewData["Page"] = "orders";

    var order = Model.Order;
    string statusClass = order.Status switch
    {
        OrderStatus.Processing => "status--processing",
        OrderStatus.Completed => "status--delivered",
        OrderStatus.Cancelled => "status--cancelled",
        _ => "status--processing"
    };
}

<style>
    .status--cancelled {
        background: #ffe0e0;
        color: #c0392b;
    }

    .od-item {
        display: grid;
        grid-template-columns: 60px 1fr auto;
        gap: 14px;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #f0e6ee;
    }

        .od-item:last-child {
            border-bottom: none;
        }

    .od-thumb {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        overflow: hidden;
        background: #fbe8f1;
        display: grid;
        place-items: center;
        font-size: 1.4rem;
    }

        .od-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .od-qty {
        color: #888;
        font-size: .9rem;
    }
</style>

<section class="section">
    <div class="wrap">

        <a asp-controller="User" asp-action="Orders" class="link-back">← Back to orders</a>

        <div class="page-head" style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
            <div>
                <span class="eyebrow">📦 Order #@order.Id</span>
                <h1>Order details</h1>
                <span class="order-date">Placed @order.OrderDate.ToString("MMMM d, yyyy 'at' h:mm tt")</span>
            </div>
            <span class="status @statusClass" style="font-size:1rem;">@order.Status</span>
        </div>

        <div class="cart-layout">

            <!-- ===== Items ===== -->
            <div class="form-card">
                <h3>Items</h3>

                @foreach (var item in order.OrderItems)
                {
                    var img = item.Product?.ProductImages?.FirstOrDefault(i => i.IsPrimary)?.ImagePath
                              ?? item.Product?.ProductImages?.FirstOrDefault()?.ImagePath;
                    <div class="od-item">
                        <div class="od-thumb">
                            @if (!string.IsNullOrEmpty(img))
                            {
                                <img src="@img" alt="@item.Product?.Name" />
                            }
                            else
                            {
                                <span>🧸</span>
                            }
                        </div>
                        <div>
                            <strong>@(item.Product?.Name ?? "Product")</strong>
                            <div class="od-qty">@item.UnitPrice.ToString("C") × @item.Quantity</div>
                        </div>
                        <div class="line-price">@((item.UnitPrice * item.Quantity).ToString("C"))</div>
                    </div>
                }
            </div>

            <!-- ===== Summary + delivery ===== -->
            <aside class="summary">
                <h3>Summary</h3>
                <div class="sum-row">
                    <span>Items (@Model.TotalItems)</span>
                    <span>@order.TotalAmount.ToString("C")</span>
                </div>
                <div class="sum-row">
                    <span>Shipping</span>
                    <span>Free</span>
                </div>
                <div class="sum-row total">
                    <span>Total</span>
                    <span>@order.TotalAmount.ToString("C")</span>
                </div>

                <div class="sum-row">
                    <span>Payment</span>
                    <span>@(order.IsPaid ? "Paid ✅" : "Unpaid")</span>
                </div>

                <a asp-controller="User" asp-action="Invoice" asp-route-id="@order.Id" class="btn btn--block" style="margin-top:16px;">
                    🧾 View invoice
                </a>

                <hr style="margin:20px 0;border:none;border-top:1px solid #f0e6ee;" />

                <h3>Delivery details</h3>
                <p style="line-height:1.7;margin:0;">
                    <strong>@order.CustomerName</strong><br />
                    @order.PhoneNumber<br />
                    @order.ShippingAddress<br />
                    @order.City
                    @if (!string.IsNullOrWhiteSpace(order.Notes))
                    {
                        <br /><span class="meta">Notes: @order.Notes</span>
                    }
                </p>
            </aside>

        </div>

    </div>
</section>

@section Scripts {
    <partial name="_ToastTrigger" />
}