@model BabyToddlerEssentials.Models.Product
@{
    ViewData["Title"] = "Delete Product";
    Layout = "_AdminLayout";
    var primaryImg = Model.ProductImages?.FirstOrDefault(i => i.IsPrimary)?.ImagePath
                     ?? Model.ProductImages?.FirstOrDefault()?.ImagePath
                     ?? "/images/default-product.png";
}

<div class="page-head">
    <div>
        <h1>Delete Product</h1>
        <p>Confirm the deletion of this product from your catalog</p>
    </div>
    <a asp-controller="Product" asp-action="Manage" class="btn btn-secondary">Cancel</a>
</div>

<div class="form-card" style="max-width: 600px; margin: 0 auto;">
    <div class="modal__body" style="padding: 20px 0; text-align: center;">
        <div class="modal__icon-danger" style="margin-bottom: 16px;">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <h3>Are you sure you want to delete this product?</h3>
        <p class="cell-muted">This action cannot be undone. The product and all its images will be permanently removed.</p>
    </div>

    <div class="table-scroll" style="margin-bottom: 24px;">
        <table class="data-table">
            <tbody>
                <tr>
                    <td style="width: 100px;"><strong>Product</strong></td>
                    <td>
                        <div class="cell-product">
                            <img src="@primaryImg" alt="@Model.Name" class="cell-thumb">
                            <span class="cell-title">@Model.Name</span>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td><strong>Category</strong></td>
                    <td class="cell-muted">@(Model.Category?.Name ?? "—")</td>
                </tr>
                <tr>
                    <td><strong>Price</strong></td>
                    <td>
                        @if (Model.DiscountPrice.HasValue)
                        {
                            <strong>$@Model.DiscountPrice.Value.ToString("0.00")</strong>
                            <span class="cell-muted"><del>$@Model.Price.ToString("0.00")</del></span>
                        }
                        else
                        {
                            <span>$@Model.Price.ToString("0.00")</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td><strong>Stock</strong></td>
                    <td>
                        <span class="badge @(Model.StockQuantity > 5 ? "badge--success" : "badge--warning")">
                            @Model.StockQuantity left
                        </span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <form asp-controller="Product" asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="form-actions" style="justify-content: center;">
            <a asp-controller="Product" asp-action="Manage" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger">
                <i class="fa-solid fa-trash"></i> Permanently Delete
            </button>
        </div>
    </form>
</div>