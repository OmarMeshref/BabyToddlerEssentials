@model BabyToddlerEssentials.Models.Order
@{
    ViewData["Title"] = $"Order #{Model.Id}";
    Layout = "_AdminLayout";
}

<div class="page-head">
    <div>
        <h1 id="orderTitle">Order #@Model.Id</h1>
        <p id="orderSubtitle">Placed on @Model.OrderDate.ToString("MMM dd, yyyy - hh:mm tt")</p>
    </div>
    <div class="table-actions">
        <a asp-controller="Admin" asp-action="Orders" class="btn btn-secondary">Back to Orders</a>
        <button onclick="window.print()" class="btn btn-secondary"><i class="fa-solid fa-print"></i> Print Order</button>
    </div>
</div>

<div class="detail-grid">
    <div>
        <div class="panel">
            <div class="panel__head">
                <h2 class="section-title">Products</h2>
            </div>
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OrderItems != null && Model.OrderItems.Any())
                        {
                            @foreach (var item in Model.OrderItems)
                            {
                                var img = item.Product?.ProductImages?.FirstOrDefault(i => i.IsPrimary)?.ImagePath
                                          ?? item.Product?.ProductImages?.FirstOrDefault()?.ImagePath
                                          ?? "/images/default-product.png";
                                <tr>
                                    <td>
                                        <div class="cell-product">
                                            <img src="@img" alt="@item.Product?.Name" class="cell-thumb">
                                            <div>
                                                <span class="cell-title">@(item.Product?.Name ?? "Product Unavailable")</span>
                                                <small class="cell-muted">ID: @item.ProductId</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.Quantity</td>
                                    <td>$@item.UnitPrice.ToString("0.00")</td>
                                    <td><strong>$@((item.UnitPrice * item.Quantity).ToString("0.00"))</strong></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="panel">
            <div class="panel__head">
                <h2 class="section-title">Customer Information</h2>
            </div>
            <div class="info-list">
                <div class="info-list__row"><span>Name</span><strong>@Model.CustomerName</strong></div>
                <div class="info-list__row"><span>Email</span><span>@(Model.User?.Email ?? "—")</span></div>
                <div class="info-list__row"><span>Phone</span><span>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</span></div>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="info-list__row"><span>Notes</span><span>@Model.Notes</span></div>
                }
            </div>
        </div>
    </div>

    <div>
        <div class="panel">
            <div class="panel__head"><h2 class="section-title">Order Status</h2></div>
            <form asp-controller="Admin" asp-action="UpdateOrderStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="form-field">
                    <label for="newStatus">Update status</label>
                    <select name="newStatus" id="newStatus" class="select-control">
                        <option value="Processing" selected="@(Model.Status == BabyToddlerEssentials.Models.Enums.OrderStatus.Processing)">Processing</option>
                        <option value="Completed" selected="@(Model.Status == BabyToddlerEssentials.Models.Enums.OrderStatus.Completed)">Completed</option>
                        <option value="Cancelled" selected="@(Model.Status == BabyToddlerEssentials.Models.Enums.OrderStatus.Cancelled)">Cancelled</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary btn-block"><i class="fa-solid fa-check"></i> Change Status</button>
            </form>
            <div class="menu-divider"></div>
            <div class="info-list__row">
                <span>Payment status</span>
                <span class="badge @(Model.IsPaid ? "badge--success" : "badge--warning")">
                    @(Model.IsPaid ? "Paid" : "Pending")
                </span>
            </div>
        </div>

        <div class="panel">
            <div class="panel__head"><h2 class="section-title">Shipping Information</h2></div>
            <div class="info-list">
                <div class="info-list__row"><span>Address</span><span>@(string.IsNullOrEmpty(Model.ShippingAddress) ? "—" : Model.ShippingAddress)</span></div>
                <div class="info-list__row"><span>City</span><span>@(string.IsNullOrEmpty(Model.City) ? "—" : Model.City)</span></div>
            </div>
        </div>

        <div class="panel">
            <div class="panel__head"><h2 class="section-title">Order Summary</h2></div>
            <div class="info-list">
                <div class="info-list__row"><span>Total Amount</span><strong>$@Model.TotalAmount.ToString("0.00")</strong></div>
            </div>
        </div>
    </div>
</div>