@model IEnumerable<BabyToddlerEssentials.Models.Order>
@{
    ViewData["Title"] = "Orders";
    Layout = "_AdminLayout";
}

<div class="page-head">
    <div>
        <h1>Orders</h1>
        <p>Track and manage customer orders</p>
    </div>
</div>

<div class="panel">
    <div class="toolbar">
        <div class="search-input">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="orderIdSearch" placeholder="Search by Order #, customer name, or email..." oninput="handleFilterChange()">
        </div>

        <select class="select-control" id="orderStatusFilter" onchange="handleFilterChange()">
            <option value="">All Status</option>
            <option value="Processing">Processing</option>
            <option value="Completed">Completed</option>
            <option value="Cancelled">Cancelled</option>
        </select>
    </div>

    <div class="table-scroll">
        <table class="data-table" id="ordersTable">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Payment</th>
                    <th>Status</th>
                    <th class="actions-cell">Actions</th>
                </tr>
            </thead>
            <tbody id="ordersTableBody">
                @if (Model != null && Model.Any())
                {
                    @foreach (var order in Model)
                    {
                        string statusBadgeClass = order.Status switch
                        {
                            BabyToddlerEssentials.Models.Enums.OrderStatus.Completed => "badge--success",
                            BabyToddlerEssentials.Models.Enums.OrderStatus.Processing => "badge--warning",
                            BabyToddlerEssentials.Models.Enums.OrderStatus.Cancelled => "badge--neutral",
                            _ => "badge--neutral"
                        };

                        <tr class="order-row" data-status="@order.Status.ToString()">
                            <td>
                                <strong>#@order.Id</strong>
                            </td>
                            <td>
                                <div class="cell-product">
                                    <span class="avatar">
                                        @(string.IsNullOrEmpty(order.CustomerName) ? "CU" : order.CustomerName.Substring(0, Math.Min(2, order.CustomerName.Length)).ToUpper())
                                    </span>
                                    <div>
                                        <span class="cell-title">@order.CustomerName</span>
                                        <small class="cell-muted">@(order.User?.Email ?? order.PhoneNumber)</small>
                                    </div>
                                </div>
                            </td>
                            <td class="cell-muted">@order.OrderDate.ToString("MMM dd, yyyy")</td>
                            <td>@(order.OrderItems?.Sum(i => i.Quantity) ?? 0) pcs</td>
                            <td>
                                <strong>@order.TotalAmount.ToString("0.00") JOD</strong>
                            </td>
                            <td>
                                <span class="badge @(order.IsPaid ? "badge--success" : "badge--warning")">
                                    @(order.IsPaid ? "Paid" : "Pending")
                                </span>
                            </td>
                            <td>
                                <span class="badge @statusBadgeClass">
                                    @order.Status
                                </span>
                            </td>
                            <td class="actions-cell">
                                <div class="table-actions">
                                    <a asp-controller="Admin" asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-secondary btn-sm" title="View Details">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr id="emptyStaticRow">
                        <td colspan="8">
                            <div class="empty-state">
                                <div class="empty-state__icon"><i class="fa-solid fa-bag-shopping"></i></div>
                                <h3>No orders yet</h3>
                                <p>Orders will appear here as customers check out.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

   
    <div id="ordersPaginationContainer" style="display: none; justify-content: space-between; align-items: center; padding: 18px 0 6px; border-top: 1px solid var(--line, #F3E3EE); margin-top: 15px;">
        <div id="ordersPaginationInfo" style="font-size: 0.9rem; color: var(--ink-soft, #6B5C79); font-weight: 600;"></div>
        <div id="ordersPaginationButtons" style="display: flex; gap: 6px; align-items: center;"></div>
    </div>
</div>

@section Scripts {
    <script>
        const rowsPerPage = 10;
        let currentPage = 1;
        let visibleRows = [];

        function getFilteredRows() {
            const searchVal = document.getElementById('orderIdSearch').value.toLowerCase().trim();
            const selectedStatus = document.getElementById('orderStatusFilter').value.toLowerCase();
            const allRows = Array.from(document.querySelectorAll('#ordersTableBody tr.order-row'));

            return allRows.filter(row => {
                const text = row.innerText.toLowerCase();
                const rowStatus = (row.getAttribute('data-status') || '').toLowerCase();

                const matchesSearch = text.includes(searchVal);
                const matchesStatus = selectedStatus === '' || rowStatus === selectedStatus;

                return matchesSearch && matchesStatus;
            });
        }

        function renderOrdersPagination() {
            const allRows = Array.from(document.querySelectorAll('#ordersTableBody tr.order-row'));
            visibleRows = getFilteredRows();

            const totalRows = visibleRows.length;
            const totalPages = Math.ceil(totalRows / rowsPerPage);

            const paginationContainer = document.getElementById('ordersPaginationContainer');
            const paginationButtons = document.getElementById('ordersPaginationButtons');
            const paginationInfo = document.getElementById('ordersPaginationInfo');

           
            allRows.forEach(r => r.style.display = 'none');

            if (totalRows <= rowsPerPage) {
                paginationContainer.style.display = 'none';
                visibleRows.forEach(r => r.style.display = '');
                return;
            }

            paginationContainer.style.display = 'flex';
            const start = (currentPage - 1) * rowsPerPage;
            const end = start + rowsPerPage;

            visibleRows.forEach((row, index) => {
                if (index >= start && index < end) {
                    row.style.display = '';
                }
            });

            paginationInfo.innerHTML = `Showing Page <strong>${currentPage}</strong> of <strong>${totalPages}</strong> (${totalRows} Orders)`;

            let buttonsHtml = '';

           
            if (currentPage > 1) {
                buttonsHtml += `<button type="button" onclick="changeOrderPage(${currentPage - 1})" class="btn btn-secondary btn-sm" style="padding: 6px 12px; border-radius: 8px;"><i class="fa-solid fa-chevron-left"></i></button>`;
            }

            
            for (let i = 1; i <= totalPages; i++) {
                if (i === currentPage) {
                    buttonsHtml += `<span class="btn btn-primary btn-sm" style="padding: 6px 14px; border-radius: 8px; pointer-events: none; font-weight: 800;">${i}</span>`;
                } else if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
                    buttonsHtml += `<button type="button" onclick="changeOrderPage(${i})" class="btn btn-secondary btn-sm" style="padding: 6px 14px; border-radius: 8px; font-weight: 700;">${i}</button>`;
                } else if (i === currentPage - 3 || i === currentPage + 3) {
                    buttonsHtml += `<span style="padding: 0 4px; color: var(--ink-soft);">...</span>`;
                }
            }

           
            if (currentPage < totalPages) {
                buttonsHtml += `<button type="button" onclick="changeOrderPage(${currentPage + 1})" class="btn btn-secondary btn-sm" style="padding: 6px 12px; border-radius: 8px;"><i class="fa-solid fa-chevron-right"></i></button>`;
            }

            paginationButtons.innerHTML = buttonsHtml;
        }

        function changeOrderPage(page) {
            currentPage = page;
            renderOrdersPagination();
        }

        function handleFilterChange() {
            currentPage = 1;
            renderOrdersPagination();
        }

        document.addEventListener('DOMContentLoaded', renderOrdersPagination);
    </script>
}