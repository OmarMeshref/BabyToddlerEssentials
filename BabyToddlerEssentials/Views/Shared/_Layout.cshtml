@using Microsoft.AspNetCore.Identity
@using BabyToddlerEssentials.Models

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

@{
    var currentPage = ViewData["Page"]?.ToString();

    ApplicationUser? currentUser = null;

    if (SignInManager.IsSignedIn(User))
    {
        currentUser = await UserManager.GetUserAsync(User);
    }

    var displayName =
        !string.IsNullOrWhiteSpace(currentUser?.FullName)
            ? currentUser.FullName
            : currentUser?.Email ?? User.Identity?.Name ?? "Account";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - BabyToddlerEssentials</title>


    <!-- Existing project styles -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/BabyToddlerEssentials.styles.css"
          asp-append-version="true" />


    <!-- Baby Basket Fonts -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous">

    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Nunito:ital,wght@0,400;0,600;0,700;0,800;1,600&display=swap"
          rel="stylesheet">


    <!-- IMPORTANT: Template CSS last -->
    <link rel="stylesheet"
          href="~/template/styles.css"
          asp-append-version="true">

</head>


<body data-page="@currentPage">


    <!-- =========================
         HEADER
         ========================= -->

    <header class="site-header">

        <nav class="nav">

<a asp-controller="Home" asp-action="Index" class="brand brand--logo">
    <img src="~/images/logoBgRemoved.png" alt="Baby Basket" class="site-logo-img" asp-append-version="true" />
</a>


            <ul class="nav-links">

                <li>
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="@(currentPage == "index" ? "active" : "")">

                        Home

                    </a>
                </li>


                <!-- Enable after ProductsController -->
                <li>
                    <a asp-controller="Product" asp-action="Index" 
                    class="@(currentPage == "shop" || currentPage == "product" ? "active" : "")">

                        Shop

                    </a>
                </li>


                <!-- Enable after CategoryController -->
                <li>
                    <a asp-controller="Categories" asp-action="Index" class="@(currentPage == "categories" ? "active" : "")">

                        Categories

                    </a>
                </li>

                <li>
                    <a asp-controller="Home"
                       asp-action="About"
                       class="@(currentPage == "about" ? "active" : "")">

                        About

                    </a>
                </li>

            </ul>


            <div class="nav-actions">


                <!-- ACCOUNT -->

                <div class="account"
                     id="account">

                    <button class="icon-btn"
                            id="account-toggle"
                            type="button"
                            aria-label="Account"
                            aria-haspopup="true">

                        👤

                    </button>


                    <div class="account-menu"
                         id="account-menu">


                        @if (SignInManager.IsSignedIn(User))
                        {
                            <div class="account-hi">

                                Hi, @displayName 👋

                            </div>


                            <a asp-controller="User"
                               asp-action="Profile">

                                👤 Profile

                            </a>


                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Admin"
                                   asp-action="Index">

                                    ⚙️ Admin Dashboard

                                </a>
                            }


                            <!-- Enable when Orders feature exists -->

                            @if (User.IsInRole("User"))
                            {
                                <a asp-controller="User"
                                   asp-action="Orders">

                                    📦 Order history

                                </a>
                            }


                            <form asp-area="Identity"
                                  asp-page="/Account/Logout"
                                  asp-route-returnUrl="@Url.Action(
                                      "Index",
                                      "Home",
                                      new { area = "" })"
                                  method="post">

                                <button type="submit">

                                    ↩︎ Log out

                                </button>

                            </form>
                        }
                        else
                        {
                            <div class="account-hi">

                                Welcome!

                            </div>


                            <a asp-area="Identity"
                               asp-page="/Account/Login">

                                🔑 Log in

                            </a>


                            <a asp-area="Identity"
                               asp-page="/Account/Register">

                                ✨ Create account

                            </a>
                        }

                    </div>

                </div>

                <!-- Wishlist -->
                <a asp-controller="User"
                   asp-action="Wishlist"
                   class="icon-btn @(currentPage == "wishlist" ? "active" : "")"
                   title="Wishlist"
                   aria-label="Wishlist">

                    💖

                </a>


                <!-- Cart -->
                <a asp-controller="User"
                   asp-action="Cart"
                   class="icon-btn @(currentPage == "cart" ? "active" : "")"
                   title="Cart"
                   aria-label="Shopping cart">

                    🛍️

                </a>

                <!-- MOBILE MENU -->

                <button class="hamburger"
                        id="drawer-open"
                        type="button"
                        aria-label="Menu"
                        aria-haspopup="true"
                        aria-controls="drawer">

                    <span class="hamburger-bars">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>

                </button>

            </div>

        </nav>

    </header>


    <!-- =========================
         MOBILE DRAWER
         (kept as a sibling of <header>, NOT inside it —
          .site-header has backdrop-filter, and any ancestor
          with backdrop-filter/transform/filter becomes the
          containing block for position:fixed children, which
          breaks full-screen overlays)
         ========================= -->

    <div class="drawer"
         id="drawer">

        <div class="drawer-bg"
             id="drawer-bg">
        </div>


        <div class="drawer-panel">

            <button class="drawer-close"
                    id="drawer-close"
                    type="button"
                    aria-label="Close menu">

                ✕

            </button>


            <a asp-controller="Home"
               asp-action="Index">

                Home

            </a>


            <a asp-controller="Product" asp-action="Index">

                Shop

            </a>


            <a asp-controller="Categories" asp-action="Index">

                Categories

            </a>


            <a asp-controller="Home"
               asp-action="About">

                About

            </a>

        </div>

    </div>



    <!-- =========================
         PAGE CONTENT
         ========================= -->

    <main>

        @RenderBody()

    </main>



    <!-- =========================
         FOOTER
         ========================= -->

    <footer class="site-footer">

        <div class="wrap foot-grid">


            <div>

<a asp-controller="Home" asp-action="Index" class="brand brand--logo">
    <img src="~/images/logoFooterWhite.png" alt="Baby Basket" class="site-logo-img" asp-append-version="true" />
</a>
                <p>
                    Little things for little ones,
                    baby and toddler essentials in one place.
                </p>

            </div>


            <div class="foot-col">

                <h4>Shop</h4>

                <a asp-controller="Product" asp-action="Index">

                    Products

                </a>

                <a asp-controller="Categories" asp-action="Index">

                    Categories

                </a>

                <a asp-controller="User"
                   asp-action="Wishlist">

                    Wishlist

                </a>

                <a asp-controller="User"
                   asp-action="Cart">

                    Shopping Cart

                </a>

            </div>


            <div class="foot-col">

                <h4>Company</h4>

                <a asp-controller="Home"
                   asp-action="About">

                    Our story

                </a>

                <a asp-controller="Home"
                   asp-action="Index">

                    Home

                </a>

            </div>


            <div class="foot-col">

                <h4>Account</h4>


                @if (SignInManager.IsSignedIn(User))
                {
                    <a asp-controller="User"
                       asp-action="Profile">

                        Profile

                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin"
                           asp-action="Index">

                            Admin Dashboard

                        </a>
                    }
                }
                else
                {
                    <a asp-area="Identity"
                       asp-page="/Account/Login">

                        Log in

                    </a>

                    <a asp-area="Identity"
                       asp-page="/Account/Register">

                        Create account

                    </a>
                }

            </div>

        </div>


<div class="foot-bottom wrap">
    © @DateTime.Now.Year Baby Basket · Baby & Toddler Essentials
</div>

    </footer>



    <!-- =========================
         SCRIPTS
         ========================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    <!-- Safe global template behavior only -->
    <script src="~/template/JS/template-ui.js"
            asp-append-version="true"></script>


    <!-- Developers can add page-specific JS
         without touching Layout -->
    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>
