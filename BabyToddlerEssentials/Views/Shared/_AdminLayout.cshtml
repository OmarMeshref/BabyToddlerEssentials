<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] · LittleNest Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="~/admin/css/variables.css" asp-append-version="true">
    <link rel="stylesheet" href="~/admin/css/admin.css" asp-append-version="true">
    <link rel="stylesheet" href="~/admin/css/components.css" asp-append-version="true">
    <link rel="stylesheet" href="~/admin/css/responsive.css" asp-append-version="true">
</head>
<body data-page="dashboard">
    <div class="sidebar__backdrop" id="sidebarBackdrop"></div>
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar__header">
                <div class="sidebar__mark">LN</div>
                <div>
                    <div class="sidebar__brand-name">LittleNest</div>
                    <div class="sidebar__brand-sub">Admin Panel</div>
                </div>
            </div>
            <nav class="sidebar__nav" aria-label="Main navigation">
                <a asp-controller="Admin" asp-action="Index" class="nav-item" data-page="dashboard"><i class="fa-solid fa-grip"></i><span>Dashboard</span></a>
                <a asp-controller="Products" asp-action="Index" class="nav-item" data-page="products"><i class="fa-solid fa-shirt"></i><span>Products</span></a>
                <a asp-controller="Categories" asp-action="Index" class="nav-item" data-page="categories"><i class="fa-solid fa-layer-group"></i><span>Categories</span></a>
                <a asp-controller="Admin" asp-action="Orders" class="nav-item" data-page="orders"><i class="fa-solid fa-bag-shopping"></i><span>Orders</span></a>
                <a asp-controller="Admin" asp-action="Users" class="nav-item" data-page="users"><i class="fa-solid fa-users"></i><span>Users</span></a>
                <a asp-controller="Admin" asp-action="Reviews" class="nav-item" data-page="reviews"><i class="fa-solid fa-star"></i><span>Reviews</span></a>
                <a asp-controller="Admin" asp-action="Testimonials" class="nav-item" data-page="testimonials"><i class="fa-solid fa-quote-right"></i><span>Testimonials</span></a>
                <a asp-controller="Home" asp-action="Index" class="nav-item"><i class="fa-solid fa-store"></i><span>Storefront</span></a>
            </nav>
            <div class="sidebar__footer">
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" id="logoutForm">
                    <button type="submit" class="nav-item nav-item--logout" style="background:none;border:none;width:100%;text-align:left;cursor:pointer;">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i><span>Logout</span>
                    </button>
                </form>
            </div>
        </aside>
        <div class="main-col">
            <header class="topbar">
                <div class="topbar__left">
                    <button class="topbar__menu-btn" id="menuToggle" aria-label="Open menu"><i class="fa-solid fa-bars"></i></button>
                    <div>
                        <div class="topbar__title">@ViewData["Title"]</div>
                        <div class="topbar__crumb">Admin / @ViewData["Title"]</div>
                    </div>
                </div>
                <div class="topbar__right">
                    <div class="dropdown">
                        <button class="profile-trigger" data-dropdown-trigger="profilePanel">
                            <span class="avatar">AD</span>
                            <span>
                                <span class="profile-trigger__name" style="display:block;">@User.Identity?.Name</span>
                                <span class="profile-trigger__role" style="display:block;">Administrator</span>
                            </span>
                            <i class="fa-solid fa-chevron-down" style="font-size:10px;color:var(--muted);"></i>
                        </button>
                        <div class="dropdown-panel dropdown-panel--menu" id="profilePanel">
                            <a class="menu-item" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-store"></i>Storefront</a>
                            <div class="menu-divider"></div>
                            <button type="submit" form="logoutForm" class="menu-item menu-item--danger" style="background:none;border:none;width:100%;text-align:left;cursor:pointer;">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i>Logout
                            </button>
                        </div>
                    </div>
                </div>
            </header>
            <main class="page">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/admin/js/ui.js" asp-append-version="true"></script>
    <script src="~/admin/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>