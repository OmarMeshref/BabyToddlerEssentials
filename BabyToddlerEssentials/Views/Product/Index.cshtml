@model BabyToddlerEssentials.ViewModels.ProductListVM
@using BabyToddlerEssentials.Helpers

@{
    ViewData["Title"] = "Shop";
    ViewData["Page"] = "shop";
}

<style>
    /* Make the results column fill its grid track and center the empty state */
    .shop-results {
        min-height: 200px;
    }

    .shop-results .empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        min-height: 320px;
    }

    /* Keep the price inputs inside the filter card */
    .filters .field-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .filters .field-grid .field {
        width: 100%;
        box-sizing: border-box; /* padding/border no longer push the box wider */
        min-width: 0; /* lets the input shrink inside the grid cell */
    }

    /* Space between the Apply filters and Clear all buttons */
    .filters .btn--block + .btn--block {
        margin-top: 12px;
    }

    /* Make the whole card clickable (stretched link), keeping buttons clickable */
    .card {
        position: relative;
    }

    .card-title-link::after {
        content: "";
        position: absolute;
        inset: 0; /* covers the entire card */
        z-index: 1;
    }
    /* keep interactive elements above the stretched link */
    .card .add-btn,
    .card form,
    .card .card-media {
        position: relative;
        z-index: 2;
    }

    /* Original (pre-discount) price: crossed out + smaller */
    .was {
        text-decoration: line-through;
        font-size: 0.7em;
        opacity: 0.65;
        font-weight: 600;
        margin-left: 6px;
    }

    /* Shift shop content up now that the header is removed */
    .section {
        padding-top: 24px;
    }

    /* Sticky filter sidebar on desktop only */
    @@media (min-width: 981px) {
        .filters {
            position: sticky;
            top: 90px; /* clears the fixed header */
            align-self: start; /* needed for sticky inside a grid */
            max-height: calc(100vh - 110px);
            overflow-y: auto; /* scroll inside if filters get tall */
        }
    }
</style>


<!-- ===== Page header ===== -->
<section class="section">
    <div class="wrap">

        <!-- ===== Search + sort bar (GET so filters live in the URL) ===== -->
        <form asp-controller="Product" asp-action="Index" method="get" class="shop-topbar reveal">

            <div class="search-box">
                <span>🔍</span>
                <input type="search"
                       name="search"
                       value="@Model.Search"
                       placeholder="Search products or categories..."
                       aria-label="Search products" />
            </div>

            <select name="sort" class="select" aria-label="Sort products" onchange="this.form.submit()">
                <option value="">Newest</option>
                <option value="price_asc" selected="@(Model.Sort == "price_asc")">Price: low to high</option>
                <option value="price_desc" selected="@(Model.Sort == "price_desc")">Price: high to low</option>
                <option value="name" selected="@(Model.Sort == "name")">Name (A–Z)</option>
            </select>

            <button class="btn btn--sky" type="submit">Search</button>

            <span class="result-count">@Model.TotalCount item(s)</span>
        </form>

        <div class="shop-wrap">

            <!-- ===== Sidebar filters ===== -->
            <aside class="filters reveal">

                <form asp-controller="Product" asp-action="Index" method="get">

                    <!-- keep the search term when filtering -->
                    <input type="hidden" name="search" value="@Model.Search" />
                    <input type="hidden" name="sort" value="@Model.Sort" />

                    <div class="filter-group">
                        <span class="label">Category</span>
                        <select name="categoryId" class="select">
                            <option value="">All categories</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                            }
                        </select>
                    </div>

                    <div class="filter-group">
                        <span class="label">Price range</span>
                        <div class="field-grid">
                            <input class="field" type="number" name="minPrice" min="0" step="0.01"
                                   value="@(Model.MinPrice)" placeholder="Min" aria-label="Minimum price" />
                            <input class="field" type="number" name="maxPrice" min="0" step="0.01"
                                   value="@(Model.MaxPrice)" placeholder="Max" aria-label="Maximum price" />
                        </div>
                    </div>

                    <button class="btn btn--block" type="submit">Apply filters</button>
                    <a asp-controller="Product" asp-action="Index" class="btn btn--ghost btn--block btn--sm">Clear all</a>

                </form>

            </aside>

            <!-- ===== Product grid column ===== -->
            <div class="shop-results" id="shopResults">
                <partial name="_ProductGrid" model="Model" />
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <!-- Toast: show any TempData messages via the template's window.toast() -->
    <partial name="_ToastStyle" />
    <partial name="_ToastTrigger" />
    <partial name="_AjaxCartWishlist" />

    <script>
        (function () {
            const results = document.getElementById('shopResults');
            if (!results) return;

            let timer = null;

            function liveSearch() {
                // read the live value fresh each time, from the visible search box
                const box = document.querySelector('.search-box input[name="search"]');
                const term = box ? box.value.trim() : '';

                const params = new URLSearchParams();
                if (term) params.set('search', term);

                // scope filter selectors so they don't grab the hidden duplicate inputs
                const cat  = document.querySelector('.filters [name="categoryId"]');
                const min  = document.querySelector('.filters [name="minPrice"]');
                const max  = document.querySelector('.filters [name="maxPrice"]');
                const sort = document.querySelector('.shop-topbar [name="sort"]');
                if (cat && cat.value)   params.set('categoryId', cat.value);
                if (min && min.value)   params.set('minPrice', min.value);
                if (max && max.value)   params.set('maxPrice', max.value);
                if (sort && sort.value) params.set('sort', sort.value);

                fetch('/Product/Index?' + params.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (res) { return res.text(); })
                    .then(function (html) { results.innerHTML = html; })
                    .catch(function () { /* ignore transient errors while typing */ });
            }

            // debounce: wait 300ms after the user stops typing
            const box = document.querySelector('.search-box input[name="search"]');
            if (box) {
                box.addEventListener('input', function () {
                    clearTimeout(timer);
                    timer = setTimeout(liveSearch, 300);
                });
            }
        })();
    </script>
}