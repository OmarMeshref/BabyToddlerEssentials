@model BabyToddlerEssentials.ViewModels.Categories.CategoriesDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
    ViewData["Page"] = "categories";
}

<section class="about-hero">

    <div class="wrap">

        <a asp-controller="Categories"
           asp-action="Index"
           class="link-back">

            ← All categories

        </a>


        <div style="margin-top:24px;">

            <span class="eyebrow">
                Category
            </span>

            <h1>
                @Model.Name
            </h1>


            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p>
                    @Model.Description
                </p>
            }

        </div>

    </div>

</section>


<section class="section">

    <div class="wrap">

        <div class="section-head reveal">

            <span class="eyebrow">
                Products
            </span>

            <h2>
                Explore @Model.Name
            </h2>

            <p>
                @Model.Products.Count
                @(Model.Products.Count == 1
                    ? "product"
                    : "products")
                currently available.
            </p>

        </div>


        @if (Model.Products.Any())
        {
            <div class="product-grid reveal">

                @foreach (var product in Model.Products)
                {
                    <article class="card">


                        <a asp-controller="Product"
                           asp-action="Details"
                           asp-route-id="@product.Id"
                           class="card-media bg-a">

                            @if (!string.IsNullOrWhiteSpace(product.ImagePath))
                            {
                                <img src="@product.ImagePath"
                                     alt="@product.Name"
                                     style="width:100%;
                                height:100%;
                                object-fit:cover;" />
                            }
                            else
                            {
                                <span class="emoji">
                                    🧸
                                </span>
                            }

                        </a>


                        <div class="card-body">

                            <span class="card-cat">
                                @Model.Name
                            </span>


                            <a asp-controller="Product"
                               asp-action="Details"
                               asp-route-id="@product.Id">

                                <h3 class="card-title">
                                    @product.Name
                                </h3>

                            </a>


                            @if (product.StockQuantity <= 0)
                            {
                                <div class="card-rating">
                                    Out of stock
                                </div>
                            }
                            else
                            {
                                <div class="card-rating">
                                    @product.StockQuantity in stock
                                </div>
                            }


                            <div class="card-foot">

                                <div class="price">

                                    @product.Price.ToString("0.00") JOD

                                </div>


                                <!--
                                Enable after ProductsController Details exists.
                                -->

                                <a asp-controller="Product"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="add-btn"
                                   aria-label="View @product.Name">
                                    →
                                </a>

                            </div>

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="empty reveal">

                <div class="big">
                    🧸
                </div>

                <h3>
                    No products yet
                </h3>

                <p>
                    Products in this category will appear here.
                </p>

            </div>
        }

    </div>

</section>