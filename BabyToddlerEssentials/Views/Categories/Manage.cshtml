@model BabyToddlerEssentials.ViewModels.Categories.CategoriesManageViewModel

@{
    ViewData["Title"] = "Manage Categories";
    ViewData["Page"] = "admin";
}

<section class="page-head">

    <div class="wrap">

        <span class="eyebrow">
            Admin
        </span>

        <h1>
            Manage Categories
        </h1>

        <p style="color:var(--ink-soft);">
            Create, edit and manage product categories.
        </p>

    </div>

</section>


<section class="section"
         style="padding-top:20px;">

    <div class="wrap">


        <!-- SUCCESS / ERROR -->
        @if (TempData["SuccessMessage"] is string success)
        {
            <div class="auth-msg show ok">
                @success
            </div>
        }


        @if (TempData["ErrorMessage"] is string error)
        {
            <div class="auth-msg show bad">
                @error
            </div>
        }



        <!-- FILTERS -->

        <div class="form-card">

            <form asp-controller="Categories"
                  asp-action="Manage"
                  method="get">

                <div class="field-grid">


                    <div class="field">

                        <label>
                            Search
                        </label>

                        <input type="search"
                               name="search"
                               value="@Model.SearchTerm"
                               placeholder="Category name..." />

                    </div>


                    <div class="field">

                        <label>
                            Status
                        </label>

                        <select name="isActive">

                            <option value="">
                                All
                            </option>

                            <option value="true"
                                    selected="@(Model.IsActive == true)">
                                Active
                            </option>

                            <option value="false"
                                    selected="@(Model.IsActive == false)">
                                Inactive
                            </option>

                        </select>

                    </div>

                </div>


                <div style="
                    display:flex;
                    gap:10px;
                    flex-wrap:wrap;
                    margin-top:16px;">

                    <button class="btn btn--sky"
                            type="submit">

                        Filter

                    </button>


                    <a asp-controller="Categories"
                       asp-action="Manage"
                       class="btn btn--ghost">

                        Clear

                    </a>


                    <a asp-controller="Categories"
                       asp-action="Create"
                       class="btn"
                       style="margin-left:auto;">

                        + Add Category

                    </a>

                </div>

            </form>

        </div>



        <!-- TABLE -->
        @if (Model.Categories.Any())
        {
            <div class="form-card"
                 style="overflow-x:auto;">

                <table class="inv-table">

                    <thead>

                        <tr>

                            <th>
                                Category
                            </th>

                            <th>
                                Products
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var category in Model.Categories)
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @category.Name
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(category.Description))
                                    {
                                        <div style="
                                            color:var(--ink-soft);
                                            font-size:.85rem;">

                                            @category.Description

                                        </div>
                                    }

                                </td>


                                <td>
                                    @category.ProductCount
                                </td>


                                <td>

                                    @if (category.IsActive)
                                    {
                                        <span class="status status--delivered">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status status--processing">
                                            Inactive
                                        </span>
                                    }

                                </td>


                                <td>

                                    <div style="
                                        display:flex;
                                        gap:8px;
                                        flex-wrap:wrap;">

                                        <a asp-controller="Categories"
                                           asp-action="Edit"
                                           asp-route-id="@category.Id"
                                           class="btn btn--sm btn--sky">

                                            Edit

                                        </a>


                                        <a asp-controller="Categories"
                                           asp-action="Delete"
                                           asp-route-id="@category.Id"
                                           class="btn btn--sm btn--ghost">

                                            Delete

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty">

                <div class="big">
                    🗂️
                </div>

                <h3>
                    No categories found
                </h3>

            </div>
        }

    </div>

</section>