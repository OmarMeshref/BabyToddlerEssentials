@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Reset password";
    Layout = "_AuthLayout";
}

<div class="auth-shell">

    <div class="auth-card auth-card--single">

        <div class="auth-main">

            <h1>
                Forgot password?
            </h1>

            <p class="auth-sub">
                No worries — enter your email and we'll
                send a reset link.
            </p>

            <div asp-validation-summary="ModelOnly"
                 class="auth-validation"
                 role="alert">
            </div>

            <form method="post">

                <div class="field">

                    <label asp-for="Input.Email">
                        Email
                    </label>

                    <input asp-for="Input.Email"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="you@email.com" />

                    <span asp-validation-for="Input.Email"
                          class="err">
                    </span>

                </div>

                <button type="submit"
                        class="btn btn--block">

                    Send reset link 📬

                </button>

            </form>

            <p class="auth-alt">

                Remembered it?

                <a asp-page="./Login">
                    Back to log in
                </a>

            </p>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}