@page
@model ForgotPasswordConfirmation

@{
    ViewData["Title"] = "Check your email";
    Layout = "_AuthLayout";
}

<div class="auth-shell">

    <div class="auth-card auth-card--single">

        <div class="auth-main">

            <h1>
                Check your email
            </h1>

            <p class="auth-sub">
                If an account exists with that email address,
                you'll receive instructions to reset your password.
            </p>

            <div class="auth-confirmation">

                <div class="auth-confirmation-icon">
                    ✉️
                </div>

                <p>
                    Check your inbox and follow the password
                    reset link to create a new password.
                </p>

                <a asp-page="./Login"
                   class="btn btn--block">

                    Back to login

                </a>

            </div>

        </div>

    </div>

</div>