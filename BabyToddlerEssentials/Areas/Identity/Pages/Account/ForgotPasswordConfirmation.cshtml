@page
@model ForgotPasswordConfirmation

@{
    ViewData["Title"] = "Check your email";
}

<div class="auth-page">

    <div class="auth-card">

        <div class="auth-brand">
            <span class="bean">🍬</span>
            <span>Jellybean</span>
        </div>

        <div class="auth-header">

            <span class="eyebrow">
                Almost there
            </span>

            <h1>
                Check your email
            </h1>

            <p>
                If an account exists with that email address,
                you'll receive instructions to reset your password.
            </p>

        </div>

        <div class="auth-confirmation">

            <div class="auth-confirmation-icon">
                ✉️
            </div>

            <p>
                Check your inbox and follow the password reset link
                to create a new password.
            </p>

            <a asp-page="./Login"
               class="auth-submit auth-submit-link">

                Back to login

            </a>

        </div>

    </div>

</div>