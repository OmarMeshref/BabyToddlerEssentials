@page
@model RegisterModel

@{
    ViewData["Title"] = "Create account";
    Layout = "_AuthLayout";
}

<div class="auth-shell">

    <div class="auth-card">

        <aside class="auth-aside">

            <span class="spark a1">🎈</span>
            <span class="spark a2">🌈</span>

            <span class="eyebrow" style="color:#fff">
                Join the club
            </span>

            <h2>
                Get 10% off your first treat
            </h2>

            <p>
                Create an account and unlock a warmer,
                faster shopping experience.
            </p>

            <ul>
                <li>🎁 Members-only deals</li>
                <li>⚡ One-tap checkout</li>
                <li>📦 Order history &amp; invoices</li>
            </ul>

        </aside>

        <div class="auth-main">

            <h1>
                Create account
            </h1>

            <p class="auth-sub">
                It takes less than a minute.
            </p>

            <div asp-validation-summary="ModelOnly"
                 class="auth-validation"
                 role="alert">
            </div>

            <form id="registerForm"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post"
                  onsubmit="return jbCombineName()">

                <!-- Not bound to the model — combined into Input.FullName on submit -->
                <div class="field-grid">

                    <div class="field">
                        <label for="rg-fn">First name</label>
                        <input id="rg-fn" placeholder="Alex" autocomplete="given-name" />
                        <span class="err" id="rg-fn-err">Required</span>
                    </div>

                    <div class="field">
                        <label for="rg-ln">Last name</label>
                        <input id="rg-ln" placeholder="Rivera" autocomplete="family-name" />
                        <span class="err" id="rg-ln-err">Required</span>
                    </div>

                </div>

                <!-- Actual model field, hidden — filled by JS before submit -->
                <input type="hidden" asp-for="Input.FullName" id="rg-fullname" />
                <span asp-validation-for="Input.FullName" class="err"></span>

                <div class="field">

                    <label asp-for="Input.Email">
                        Email
                    </label>

                    <input asp-for="Input.Email"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="you@email.com" />

                    <span asp-validation-for="Input.Email"
                          class="err">
                    </span>

                </div>

                <div class="field-grid">

                    <div class="field">

                        <label asp-for="Input.Password">
                            Password
                        </label>

                        <input asp-for="Input.Password"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="At least 6 characters" />

                        <span asp-validation-for="Input.Password"
                              class="err">
                        </span>

                    </div>

                    <div class="field">

                        <label asp-for="Input.ConfirmPassword">
                            Confirm password
                        </label>

                        <input asp-for="Input.ConfirmPassword"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Repeat password" />

                        <span asp-validation-for="Input.ConfirmPassword"
                              class="err">
                        </span>

                    </div>

                </div>

                <button id="registerSubmit"
                        type="submit"
                        class="btn btn--block">

                    Create account ✨

                </button>

            </form>

            <p class="auth-alt">

                Already have an account?

                <a asp-page="./Login"
                   asp-route-returnUrl="@Model.ReturnUrl">

                    Log in

                </a>

            </p>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function jbCombineName() {
            const fn = document.getElementById('rg-fn').value.trim();
            const ln = document.getElementById('rg-ln').value.trim();

            document.getElementById('rg-fn-err').style.display = fn ? 'none' : 'block';
            document.getElementById('rg-ln-err').style.display = ln ? 'none' : 'block';

            if (!fn || !ln) return false;

            document.getElementById('rg-fullname').value = `${fn} ${ln}`;
            return true;
        }
    </script>
}