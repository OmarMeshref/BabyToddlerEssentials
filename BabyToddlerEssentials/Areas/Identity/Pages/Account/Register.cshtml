@page
@model RegisterModel

@{
    ViewData["Title"] = "Create account";
}

<div class="auth-page">

    <div class="auth-card">

        <div class="auth-brand">
            <span class="bean">🍬</span>
            <span>Jellybean</span>
        </div>

        <div class="auth-header">

            <span class="eyebrow">
                Join Jellybean
            </span>

            <h1>
                Create your account
            </h1>

            <p>
                Create an account to manage your orders and wishlist.
            </p>

        </div>

        <form id="registerForm"
              asp-route-returnUrl="@Model.ReturnUrl"
              method="post"
              class="auth-form">

            <div asp-validation-summary="ModelOnly"
                 class="auth-validation"
                 role="alert">
            </div>

            <div class="auth-field">

                <label asp-for="Input.FullName">
                    Full name
                </label>

                <input asp-for="Input.FullName"
                       autocomplete="name"
                       placeholder="Your full name" />

                <span asp-validation-for="Input.FullName"
                      class="auth-error">
                </span>

            </div>

            <div class="auth-field">

                <label asp-for="Input.Email">
                    Email
                </label>

                <input asp-for="Input.Email"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@example.com" />

                <span asp-validation-for="Input.Email"
                      class="auth-error">
                </span>

            </div>

            <div class="auth-field">

                <label asp-for="Input.Password">
                    Password
                </label>

                <input asp-for="Input.Password"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Create a password" />

                <span asp-validation-for="Input.Password"
                      class="auth-error">
                </span>

            </div>

            <div class="auth-field">

                <label asp-for="Input.ConfirmPassword">
                    Confirm password
                </label>

                <input asp-for="Input.ConfirmPassword"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Repeat your password" />

                <span asp-validation-for="Input.ConfirmPassword"
                      class="auth-error">
                </span>

            </div>

            <button id="registerSubmit"
                    type="submit"
                    class="auth-submit">

                Create account

            </button>

        </form>

        <div class="auth-footer">

            <span>
                Already have an account?
            </span>

            <a asp-page="./Login"
               asp-route-returnUrl="@Model.ReturnUrl">

                Log in

            </a>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}