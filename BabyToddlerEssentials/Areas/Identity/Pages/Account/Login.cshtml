@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = "_AuthLayout";
}

<div class="auth-shell">

    <div class="auth-card">

        <aside class="auth-aside">

            <span class="spark a1">🍬</span>
            <span class="spark a2">⭐</span>

            <span class="eyebrow" style="color:#fff">
                Welcome back
            </span>

            <h2>
                Hello again!
            </h2>

            <p>
                Sign in to track orders, save favorites
                and check out faster.
            </p>

            <ul>
                <li>📦 Track every order</li>
                <li>💖 Keep your favorites</li>
                <li>🧾 Download invoices</li>
            </ul>

        </aside>

        <div class="auth-main">

            <h1>
                Log in
            </h1>

            <p class="auth-sub">
                Enter your details to continue.
            </p>

            <div asp-validation-summary="ModelOnly"
                 class="auth-validation"
                 role="alert">
            </div>

            <form id="account"
                  method="post">

                <div class="field">

                    <label asp-for="Input.Email">
                        Email
                    </label>

                    <input asp-for="Input.Email"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="you@email.com" />

                    <span asp-validation-for="Input.Email"
                          class="err">
                    </span>

                </div>

                <div class="field">

                    <label asp-for="Input.Password">
                        Password
                    </label>

                    <input asp-for="Input.Password"
                           autocomplete="current-password"
                           aria-required="true"
                           placeholder="••••••••" />

                    <span asp-validation-for="Input.Password"
                          class="err">
                    </span>

                </div>

                <div class="auth-row">

                    <label class="auth-remember">

                        <input asp-for="Input.RememberMe" />

                        <span>
                            Remember me
                        </span>

                    </label>

                    <a id="forgot-password"
                       asp-page="./ForgotPassword">

                        Forgot password?

                    </a>

                </div>

                <button id="login-submit"
                        type="submit"
                        class="btn btn--block">

                    Log in →

                </button>

            </form>

            <p class="auth-alt">

                New here?

                <a asp-page="./Register"
                   asp-route-returnUrl="@Model.ReturnUrl">

                    Create an account

                </a>

            </p>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}